{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/3ll3d00d/beqdesigner/main/docs/schema/http_designer_response.schema.json",
  "title": "HTTP designer response",
  "description": "The JSON body an HTTP-bound filter designer returns -- design/designer-interface.md §7.1, decoded caller-side by pipeline.designer.http_binding.http_designer(). DesignResponse (§3) as JSON, field-for-field; unlike the request, nothing here needs binary encoding, since a BiquadSpec carries no sample-rate-bound data by design (§5). Anything that doesn't match this shape is treated as an implementation failure (HttpDesignerError), never coerced into a decline -- see §1/§7.1.",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "candidates": {
      "description": "success: a non-empty array, best (most preferred) first -- candidates[0] is the only one the caller acts on automatically. Absent/null on decline.",
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/candidate" }
        },
        { "type": "null" }
      ]
    },
    "decline_reason": {
      "description": "decline: a short, stable, machine-usable snake_case code (§4). Absent/null on success.",
      "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "decline_message": {
      "oneOf": [{ "type": "string" }, { "type": "null" }]
    }
  },
  "required": ["contract_version"],
  "additionalProperties": true,
  "$defs": {
    "biquadSpec": {
      "type": "object",
      "properties": {
        "type": { "enum": ["peaking_eq", "low_shelf", "high_shelf"] },
        "freq_hz": { "type": "number", "exclusiveMinimum": 0 },
        "gain_db": { "type": "number" },
        "q": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["type", "freq_hz", "gain_db", "q"],
      "additionalProperties": false
    },
    "candidate": {
      "description": "DesignCandidate (§3) as JSON.",
      "type": "object",
      "properties": {
        "filters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/biquadSpec" }
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "ordinal in v1 -- comparable within this response's candidates, not across titles or implementations"
        },
        "mv_adjust_db": {
          "type": "number",
          "description": "the cascade's implied gain (catalogue mv_adjust compatibility) -- NOT a clipping-cost estimate"
        },
        "method": {
          "enum": ["exact", "fitted", "non_parametric"]
        },
        "gain_reduction_db": {
          "oneOf": [
            { "type": "number", "maximum": 0.0 },
            { "type": "null" }
          ]
        },
        "residual_db": {
          "oneOf": [{ "type": "number" }, { "type": "null" }]
        },
        "residual_band_hz": {
          "oneOf": [
            {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            { "type": "null" }
          ]
        },
        "commentary": {
          "description": "structured, human-facing notes -- dict[str, str]; not machine-parsed",
          "oneOf": [
            { "type": "object", "additionalProperties": { "type": "string" } },
            { "type": "null" }
          ]
        },
        "fc_hz": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
        "slope": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
        "fc_uncertainty_hz": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
        "slope_uncertainty": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
        "channel_scope": {
          "oneOf": [{ "enum": ["all_channels", "lfe_only", "mixed"] }, { "type": "null" }]
        }
      },
      "required": ["filters", "confidence", "mv_adjust_db", "method"],
      "additionalProperties": true
    }
  }
}
