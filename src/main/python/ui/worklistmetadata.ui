         <item>
          <widget class="QLabel" name="essentialsHeading"><property name="text"><string>Essentials</string></property></widget>
         </item>
         <item>
          <layout class="QFormLayout" name="essentialsForm">
           <property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property>
           <item row="0" column="0"><widget class="QLabel" name="titleLabel"><property name="text"><string>Title:</string></property></widget></item>
           <item row="0" column="1"><widget class="QLineEdit" name="titleField"><property name="toolTip"><string>The title as the catalogue shows it. Required.</string></property></widget></item>
           <item row="1" column="0"><widget class="QLabel" name="yearLabel"><property name="text"><string>Year:</string></property></widget></item>
           <item row="1" column="1"><widget class="QLineEdit" name="yearField"><property name="toolTip"><string>Release year (first air year for a series). Required.</string></property></widget></item>
           <item row="2" column="0"><widget class="QLabel" name="audioTypesLabel"><property name="text"><string>Audio types:</string></property></widget></item>
           <item row="2" column="1"><widget class="QLineEdit" name="audioTypesField"><property name="toolTip"><string>The audio formats this filter is for, separated by commas, e.g. Atmos, DTS-HD MA 5.1. At least one is required.</string></property></widget></item>
           <item row="3" column="0"><widget class="QLabel" name="editionLabel"><property name="text"><string>Edition:</string></property></widget></item>
           <item row="3" column="1"><widget class="QLineEdit" name="editionField"><property name="toolTip"><string>e.g. Director's Cut</string></property></widget></item>
           <item row="4" column="0"><widget class="QLabel" name="seasonLabel"><property name="text"><string>Season:</string></property></widget></item>
           <item row="4" column="1"><widget class="QLineEdit" name="seasonField"><property name="toolTip"><string>The season number, for a TV series. Blank if not a TV show. Changing it drops the TMDB season id a run looked up.</string></property></widget></item>
           <item row="5" column="0"><widget class="QLabel" name="episodesLabel"><property name="text"><string>Episodes:</string></property></widget></item>
           <item row="5" column="1"><widget class="QLineEdit" name="episodesField"><property name="toolTip"><string>The episodes of that season this filter covers, e.g. 1-8 or 1-3, 5. Blank if not a TV show.</string></property></widget></item>
           <item row="6" column="0"><widget class="QLabel" name="noteLabel"><property name="text"><string>Note:</string></property></widget></item>
           <item row="6" column="1"><widget class="QLineEdit" name="noteField"><property name="toolTip"><string>A note shown with the filter in the catalogue.</string></property></widget></item>
           <item row="7" column="0"><widget class="QLabel" name="warningLabel"><property name="text"><string>Warning:</string></property></widget></item>
           <item row="7" column="1"><widget class="QLineEdit" name="warningField"><property name="toolTip"><string>A warning shown with the filter in the catalogue.</string></property></widget></item>
           <item row="8" column="0"><widget class="QLabel" name="tmdbLabel"><property name="text"><string>TMDB id:</string></property></widget></item>
           <item row="8" column="1"><layout class="QHBoxLayout" name="tmdbLayout"><item><widget class="QLineEdit" name="movieDbIdField"><property name="toolTip"><string>The TMDB id. With one, Reload fetches that title; without, it searches by title and year.</string></property></widget></item><item><widget class="QPushButton" name="reloadTmdbButton"><property name="toolTip"><string>Look the title up on TMDB and fill in what it knows: title, year, ratings, runtime, genres. Audio types are not on TMDB. Nothing is saved until you leave the field or press Save.</string></property><property name="text"><string>Reload</string></property></widget></item></layout></item>
